# ─── .env.example ─────────────────────────────────────────────────────────────
# CATATAN: sekarang dipecah jadi dua file yang otomatis dipakai Vite:
#   • .env.development → dipakai saat `npm run dev`   (emulator Auth aktif)
#   • .env.production  → dipakai saat `npm run build`  (Firebase asli)
# File .env ini tetap dibaca duluan sebagai default sebelum di-override
# oleh salah satu file di atas, jadi cukup isi variabel yang jarang berubah.

# Backend Django API
VITE_API_BASE_URL=https://api.domain.id/api

# Firebase Config (ambil dari Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth Emulator (development only)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
